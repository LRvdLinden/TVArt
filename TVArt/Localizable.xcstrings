    "All masters": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle meesters"
          }
        }
      }
    },
    "All works": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle werken"
          }
        }
      }
    },
    "Artworks and titles come from Wikidata and Wikimedia Commons, supplemented by the open-access collections of The Metropolitan Museum of Art and the Cleveland Museum of Art. Only public-domain works are shown. These settings are also available in the Apple TV Settings app.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunstwerken en titels komen van Wikidata en Wikimedia Commons, aangevuld met de open collecties van The Metropolitan Museum of Art en het Cleveland Museum of Art. Alleen werken uit het publieke domein worden getoond. Deze instellingen staan ook in de Instellingen-app van de Apple TV."
          }
        }
      }
    },
    "Artworks are loaded live from the open-access collections of The Metropolitan Museum of Art and the Cleveland Museum of Art. Internet connection required.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunstwerken worden live geladen uit de open collecties van The Metropolitan Museum of Art en het Cleveland Museum of Art. Internetverbinding vereist."
          }
        }
      }
    },
    "Artworks are loaded live from the open-access collections of The Metropolitan Museum of Art and the Cleveland Museum of Art. Only works marked public domain by the museum are shown.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunstwerken worden live geladen uit de open collecties van The Metropolitan Museum of Art en het Cleveland Museum of Art. Alleen werken die het museum als publiek domein markeert worden getoond."
          }
        }
      }
    },
    "Artworks come from Wikidata and Wikimedia Commons, The Metropolitan Museum of Art and the Cleveland Museum of Art. Internet connection required.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunstwerken komen van Wikidata en Wikimedia Commons, The Metropolitan Museum of Art en het Cleveland Museum of Art. Internetverbinding vereist."
          }
        }
      }
    },

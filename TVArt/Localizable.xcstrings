    },
    "All works": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle werken"
          }
        }
      }
    },
    "Artworks are loaded live from the open-access collections of The Metropolitan Museum of Art and the Cleveland Museum of Art. Internet connection required.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunstwerken worden live geladen uit de open collecties van The Metropolitan Museum of Art en het Cleveland Museum of Art. Internetverbinding vereist."
          }
        }
      }
    },
    "Artworks are loaded live from the open-access collections of The Metropolitan Museum of Art and the Cleveland Museum of Art. Only works marked public domain by the museum are shown.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunstwerken worden live geladen uit de open collecties van The Metropolitan Museum of Art en het Cleveland Museum of Art. Alleen werken die het museum als publiek domein markeert worden getoond."
          }
        }
      }
    },
